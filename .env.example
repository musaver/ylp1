# Join YouthLink (app/join-youthlink) and Feedback & Complaints (app/feedback) forms. Copy to .env.local.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender for both forms, e.g. "YouthLink <forms@yourdomain.org>"
JOIN_FORM_FROM=
# One or more recipients, comma separated. Only these inboxes receive applications.
JOIN_FORM_TO=
# Optional: recipients for feedback and complaints. Falls back to JOIN_FORM_TO when unset.
FEEDBACK_FORM_TO=
